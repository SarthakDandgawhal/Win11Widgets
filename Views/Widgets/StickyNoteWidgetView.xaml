<UserControl
    x:Class="Win11Widgets.Views.Widgets.StickyNoteWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="240">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="WidgetHeaderButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{Binding SelectedColor, Converter={StaticResource StringToBrushConverter}}"
            BorderBrush="{ThemeResource WidgetBorderColor}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Sticky Note"
                    Style="{StaticResource WidgetTitleStyle}"
                    Margin="12,8,0,0"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,8,4" Spacing="4">
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Color"
                            Command="{Binding SetColorCommand}"
                            CommandParameter="#FFF9C4">
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FFF9C4" BorderBrush="#CCC" BorderThickness="1" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Color"
                            Command="{Binding SetColorCommand}"
                            CommandParameter="#FCE4EC">
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FCE4EC" BorderBrush="#CCC" BorderThickness="1" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Color"
                            Command="{Binding SetColorCommand}"
                            CommandParameter="#E3F2FD">
                        <Border Width="16" Height="16" CornerRadius="3" Background="#E3F2FD" BorderBrush="#CCC" BorderThickness="1" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Color"
                            Command="{Binding SetColorCommand}"
                            CommandParameter="#E8F5E9">
                        <Border Width="16" Height="16" CornerRadius="3" Background="#E8F5E9" BorderBrush="#CCC" BorderThickness="1" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="More colors"
                            Click="MoreColors_Click">
                        <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Duplicate"
                            Command="{Binding DuplicateCommand}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Command="{Binding CloseCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="12,0,12,12">
                <TextBox
                    x:Name="EditorTextBox"
                    Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Foreground="#333"
                    PlaceholderText="Type your note here..."
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}" />

                <RichTextBlock
                    x:Name="PreviewTextBlock"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Paragraph>
                        <Run Text="{Binding Content}" />
                    </Paragraph>
                </RichTextBlock>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Edit"
                        Command="{Binding StartEditCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                </Button>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Save"
                        Command="{Binding StopEditCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="{ThemeResource WidgetAccentColor}" />
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding State.ModifiedAt, StringFormat='Last edited: {0:g}'}"
                           Style="{StaticResource WidgetBodyStyle}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           Foreground="{ThemeResource WidgetTextSecondary}"
                           Opacity="0.7" />

                <Button Grid.Column="2"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Pin"
                        Command="{Binding PinCommand}"
                        Background="{Binding State.IsPinned, Converter={StaticResource BoolToBrushConverter}, ConverterParameter={ThemeResource WidgetAccentColor}}">
                    <FontIcon Glyph="&#xE77A;" FontSize="14" 
                              Foreground="{Binding State.IsPinned, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=White}" />
                </Button>
            </Grid>

            <!-- Resize Handle -->
            <Thumb x:Name="ResizeThumb"
                   Width="20" Height="20"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,4"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M0,12 L12,0 M4,12 L12,8 M8,12 L12,4"
                              Stroke="{ThemeResource WidgetTextSecondary}"
                              StrokeThickness="1.5"
                              Opacity="0.5"
                              Stretch="None" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>