<UserControl
    x:Class="Win11Widgets.Views.Widgets.ColorPickerWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="280"
    d:DesignHeight="320">

    <Border Background="{ThemeResource WidgetBackgroundColor}"
            BorderBrush="{ThemeResource WidgetBorderColor}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="16" 
                          Foreground="{ThemeResource WidgetAccentColor}" 
                          Margin="12,0,8,0" VerticalAlignment="Center" />
                
                <TextBlock Grid.Column="1" Text="Color Picker" Style="{StaticResource WidgetTitleStyle}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,4,8,4" Spacing="4">
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Command="{Binding CloseCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Color Preview -->
            <Border Grid.Row="1" Height="80" Margin="16,0,16,16" CornerRadius="8" BorderBrush="{ThemeResource WidgetBorderColor}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{Binding SelectedColor, Converter={StaticResource StringToColorConverter}}" />
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="{Binding SelectedColor}"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource WidgetTextPrimary}"
                                   FontFamily="Consolas" />
                        <TextBlock Text="{Binding RgbText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource WidgetTextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPrimaryButtonStyle}"
                            Margin="0,0,16,0"
                            Padding="16,8"
                            Command="{Binding CopyColorCommand}"
                            ToolTipService.ToolTip="Copy Color">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Color Sliders -->
            <Grid Grid.Row="2" Margin="16,0,16,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- RGB Sliders -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R" FontSize="13" Foreground="#FF6B6B" VerticalAlignment="Center" Width="20" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red, Mode=TwoWay}" 
                                Foreground="#FF6B6B" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Red, Mode=TwoWay}" Width="45" FontSize="12" 
                                 HorizontalAlignment="Right" InputScope="Number" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="G" FontSize="13" Foreground="#4ECDC4" VerticalAlignment="Center" Width="20" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green, Mode=TwoWay}" 
                                Foreground="#4ECDC4" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Green, Mode=TwoWay}" Width="45" FontSize="12" 
                                 HorizontalAlignment="Right" InputScope="Number" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B" FontSize="13" Foreground="#6BCB77" VerticalAlignment="Center" Width="20" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue, Mode=TwoWay}" 
                                Foreground="#6BCB77" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Blue, Mode=TwoWay}" Width="45" FontSize="12" 
                                 HorizontalAlignment="Right" InputScope="Number" />
                    </Grid>
                </StackPanel>

                <!-- HSL Sliders -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="H" FontSize="13" Foreground="#FFD93D" VerticalAlignment="Center" Width="20" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding Hue, Mode=TwoWay}" 
                                Foreground="#FFD93D" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Hue, Mode=TwoWay, StringFormat='{0:F0}'}" Width="50" FontSize="12" 
                                 HorizontalAlignment="Right" InputScope="Number" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="S" FontSize="13" Foreground="#FFD93D" VerticalAlignment="Center" Width="20" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Saturation, Mode=TwoWay}" 
                                Foreground="#FFD93D" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Saturation, Mode=TwoWay, StringFormat='{0:F0}%'}" Width="50" FontSize="12" 
                                 HorizontalAlignment="Right" InputScope="Number" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="L" FontSize="13" Foreground="#FFD93D" VerticalAlignment="Center" Width="20" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Lightness, Mode=TwoWay}" 
                                Foreground="#FFD93D" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Lightness, Mode=TwoWay, StringFormat='{0:F0}%'}" Width="50" FontSize="12" 
                                 HorizontalAlignment="Right" InputScope="Number" />
                    </Grid>
                </StackPanel>

                <!-- Format Selector -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Format:" FontSize="13" Foreground="{ThemeResource WidgetTextSecondary}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              SelectedItem="{Binding CurrentFormat, Mode=TwoWay}"
                              ItemsSource="{Binding FormatOptions}"
                              HorizontalAlignment="Stretch"
                              FontSize="12" />
                </Grid>
            </Grid>

            <!-- Saved Colors Palette -->
            <Grid Grid.Row="3" Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Saved Colors" Style="{StaticResource WidgetTitleStyle}" FontSize="14" Margin="0,0,0,8" />

                <ItemsControl Grid.Row="1" ItemsSource="{Binding SavedColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" ItemWidth="44" ItemHeight="44" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="40" Height="40" Margin="2">
                                <Border CornerRadius="6"
                                        BorderBrush="{ThemeResource WidgetBorderColor}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Converter={StaticResource StringToColorConverter}}" />
                                    </Border.Background>
                                </Border>
                                <Button Width="40" Height="40"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Click="SavedColor_Click"
                                        ToolTipService.ToolTip="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="6">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="RootGrid.Background" Value="#33FFFFFF" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="RootGrid.Background" Value="#66FFFFFF" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <ContentPresenter />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetPrimaryButtonStyle}"
                        Margin="12,0"
                        Padding="12,6"
                        Command="{Binding SaveColorCommand}"
                        ToolTipService.ToolTip="Save Current Color">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Save" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Duplicate"
                        Command="{Binding DuplicateCommand}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                </Button>
            </Grid>

            <Thumb x:Name="ResizeThumb"
                   Width="20" Height="20"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,4"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M0,12 L12,0 M4,12 L12,8 M8,12 L12,4"
                              Stroke="{ThemeResource WidgetTextSecondary}"
                              StrokeThickness="1.5"
                              Opacity="0.5"
                              Stretch="None" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>