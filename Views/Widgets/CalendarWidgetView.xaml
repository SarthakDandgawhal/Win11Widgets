<UserControl
    x:Class="Win11Widgets.Views.Widgets.CalendarWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="320">

    <Border Background="{ThemeResource WidgetBackgroundColor}"
            BorderBrush="{ThemeResource WidgetBorderColor}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="16" 
                          Foreground="{ThemeResource WidgetAccentColor}" 
                          Margin="12,0,8,0" VerticalAlignment="Center" />
                
                <TextBlock Grid.Column="1" Text="Calendar" Style="{StaticResource WidgetTitleStyle}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,4,8,4" Spacing="4">
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Command="{Binding CloseCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Month Navigation -->
            <Grid Grid.Row="1" Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        Command="{Binding PreviousMonthCommand}"
                        ToolTipService.ToolTip="Previous Month">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="{ThemeResource WidgetTextPrimary}" />
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding MonthYear}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource WidgetTextPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        Command="{Binding NextMonthCommand}"
                        ToolTipService.ToolTip="Next Month">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource WidgetTextPrimary}" />
                </Button>
            </Grid>

            <!-- Calendar Grid -->
            <Grid Grid.Row="2" Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Day Headers -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="S" Style="{StaticResource DayHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="M" Style="{StaticResource DayHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="T" Style="{StaticResource DayHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="W" Style="{StaticResource DayHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="T" Style="{StaticResource DayHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="F" Style="{StaticResource DayHeaderStyle}" />
                    <TextBlock Grid.Column="6" Text="S" Style="{StaticResource DayHeaderStyle}" />
                </Grid>

                <!-- Days -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" 
                                                   MaximumRowsOrColumns="7"
                                                   ItemWidth="40"
                                                   ItemHeight="40" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDay">
                            <Button Width="36" Height="36"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    Padding="0"
                                    FontSize="13"
                                    FontWeight="{x:Bind IsToday, Converter={StaticResource BoolToFontWeightConverter}}"
                                    Foreground="{x:Bind IsCurrentMonth, Converter={StaticResource BoolToBrushConverter}, ConverterParameter={ThemeResource WidgetTextPrimary}, ConverterLanguage=secondary}"
                                    ToolTipService.ToolTip="{x:Bind Date, StringFormat='{0:D}'}"
                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="18">
                                            <Ellipse x:Name="TodayEllipse"
                                                     Width="32" Height="32"
                                                     Stroke="{ThemeResource WidgetAccentColor}"
                                                     StrokeThickness="2"
                                                     Visibility="Collapsed" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource WidgetHoverColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource WidgetBorderColor}" />
                                    </ResourceDictionary>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        Command="{Binding TodayCommand}"
                        ToolTipService.ToolTip="Today">
                    <FontIcon Glyph="&#xE8AF;" FontSize="14" Foreground="{ThemeResource WidgetAccentColor}" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Duplicate"
                        Command="{Binding DuplicateCommand}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                </Button>
            </Grid>

            <Thumb x:Name="ResizeThumb"
                   Width="20" Height="20"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,4"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M0,12 L12,0 M4,12 L12,8 M8,12 L12,4"
                              Stroke="{ThemeResource WidgetTextSecondary}"
                              StrokeThickness="1.5"
                              Opacity="0.5"
                              Stretch="None" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>