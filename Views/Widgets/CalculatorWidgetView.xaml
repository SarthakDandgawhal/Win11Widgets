<UserControl
    x:Class="Win11Widgets.Views.Widgets.CalculatorWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="280"
    d:DesignHeight="360">

    <Border Background="{ThemeResource WidgetBackgroundColor}"
            BorderBrush="{ThemeResource WidgetBorderColor}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xEC2A;" FontSize="16" 
                          Foreground="{ThemeResource WidgetAccentColor}" 
                          Margin="12,0,8,0" VerticalAlignment="Center" />
                
                <TextBlock Grid.Column="1" Text="Calculator" Style="{StaticResource WidgetTitleStyle}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,4,8,4" Spacing="4">
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="History"
                            Click="History_Click">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Command="{Binding CloseCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Display -->
            <Grid Grid.Row="1" Margin="16,0,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Expression}"
                           FontSize="14"
                           Foreground="{ThemeResource WidgetTextSecondary}"
                           HorizontalAlignment="Right"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1"
                           Text="{Binding Display}"
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="{ThemeResource WidgetTextPrimary}"
                           HorizontalAlignment="Right"
                           FontFamily="Segoe UI" />
            </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 1 -->
                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="C" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding ClearCommand}" />
                <Button Grid.Row="0" Grid.Column="2"
                        Content="⌫" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding BackspaceCommand}" />
                <Button Grid.Row="0" Grid.Column="3"
                        Content="%" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding PercentCommand}" />

                <!-- Row 2 -->
                <Button Grid.Row="1" Grid.Column="0"
                        Content="7" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="7" />
                <Button Grid.Row="1" Grid.Column="1"
                        Content="8" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="8" />
                <Button Grid.Row="1" Grid.Column="2"
                        Content="9" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="9" />
                <Button Grid.Row="1" Grid.Column="3"
                        Content="÷" Style="{StaticResource CalcOperatorButtonStyle}"
                        Command="{Binding OperationInputCommand}" CommandParameter="/" />

                <!-- Row 3 -->
                <Button Grid.Row="2" Grid.Column="0"
                        Content="4" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="4" />
                <Button Grid.Row="2" Grid.Column="1"
                        Content="5" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="5" />
                <Button Grid.Row="2" Grid.Column="2"
                        Content="6" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="6" />
                <Button Grid.Row="2" Grid.Column="3"
                        Content="×" Style="{StaticResource CalcOperatorButtonStyle}"
                        Command="{Binding OperationInputCommand}" CommandParameter="*" />

                <!-- Row 4 -->
                <Button Grid.Row="3" Grid.Column="0"
                        Content="1" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="1" />
                <Button Grid.Row="3" Grid.Column="1"
                        Content="2" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="2" />
                <Button Grid.Row="3" Grid.Column="2"
                        Content="3" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="3" />
                <Button Grid.Row="3" Grid.Column="3"
                        Content="−" Style="{StaticResource CalcOperatorButtonStyle}"
                        Command="{Binding OperationInputCommand}" CommandParameter="-" />

                <!-- Row 5 -->
                <Button Grid.Row="4" Grid.Column="0"
                        Content="±" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding ToggleSignCommand}" />
                <Button Grid.Row="4" Grid.Column="1"
                        Content="0" Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="0" />
                <Button Grid.Row="4" Grid.Column="2"
                        Content="." Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding NumberInputCommand}" CommandParameter="." />
                <Button Grid.Row="4" Grid.Column="3"
                        Content="+" Style="{StaticResource CalcOperatorButtonStyle}"
                        Command="{Binding OperationInputCommand}" CommandParameter="+" />

                <!-- Equals spans bottom right -->
                <Button Grid.Row="4" Grid.Column="3" Grid.RowSpan="2"
                        Content="=" Style="{StaticResource CalcEqualsButtonStyle}"
                        Command="{Binding EqualsCommand}" />
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Pin"
                        Command="{Binding PinCommand}"
                        Background="{Binding State.IsPinned, Converter={StaticResource BoolToBrushConverter}, ConverterParameter={ThemeResource WidgetAccentColor}}">
                    <FontIcon Glyph="&#xE77A;" FontSize="14" 
                              Foreground="{Binding State.IsPinned, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=White}" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Duplicate"
                        Command="{Binding DuplicateCommand}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                </Button>
            </Grid>

            <Thumb x:Name="ResizeThumb"
                   Width="20" Height="20"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,4"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M0,12 L12,0 M4,12 L12,8 M8,12 L12,4"
                              Stroke="{ThemeResource WidgetTextSecondary}"
                              StrokeThickness="1.5"
                              Opacity="0.5"
                              Stretch="None" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>