<UserControl
    x:Class="Win11Widgets.Views.Widgets.SystemMonitorWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="400"
    d:DesignHeight="300">

    <Border Background="{ThemeResource WidgetBackgroundColor}"
            BorderBrush="{ThemeResource WidgetBorderColor}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xEC4A;" FontSize="16" 
                          Foreground="{ThemeResource WidgetAccentColor}" 
                          Margin="12,0,8,0" VerticalAlignment="Center" />
                
                <TextBlock Grid.Column="1" Text="System Monitor" Style="{StaticResource WidgetTitleStyle}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,4,8,4" Spacing="4">
                    <Button Style="{StaticResource WidgetHeaderButtonStyle}"
                            ToolTipService.ToolTip="Close"
                            Command="{Binding CloseCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Metrics Grid -->
            <Grid Grid.Row="1" Margin="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xEC4A;" FontSize="20" 
                          Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding CpuUsage}" Maximum="100" Height="8" 
                                     Foreground="#FF6B6B" Background="{ThemeResource WidgetBorderColor}" 
                                     CornerRadius="4" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" 
                                   FontSize="12" FontWeight="Medium" 
                                   Foreground="{ThemeResource WidgetTextPrimary}" 
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Canvas x:Name="CpuGraph" Grid.Row="1" Grid.Column="1" Height="40" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Memory -->
                <FontIcon Grid.Row="1" Grid.Column="0" Glyph="&#xE7E8;" FontSize="20" 
                          Foreground="#4ECDC4" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding MemoryUsage}" Maximum="100" Height="8" 
                                     Foreground="#4ECDC4" Background="{ThemeResource WidgetBorderColor}" 
                                     CornerRadius="4" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" 
                                   FontSize="12" FontWeight="Medium" 
                                   Foreground="{ThemeResource WidgetTextPrimary}" 
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Canvas x:Name="MemoryGraph" Height="40" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Disk -->
                <FontIcon Grid.Row="2" Grid.Column="0" Glyph="&#xE7F1;" FontSize="20" 
                          Foreground="#FFD93D" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding DiskUsage}" Maximum="100" Height="8" 
                                     Foreground="#FFD93D" Background="{ThemeResource WidgetBorderColor}" 
                                     CornerRadius="4" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DiskText}" 
                                   FontSize="12" FontWeight="Medium" 
                                   Foreground="{ThemeResource WidgetTextPrimary}" 
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Canvas x:Name="DiskGraph" Height="40" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Network -->
                <FontIcon Grid.Row="3" Grid.Column="0" Glyph="&#xE701;" FontSize="20" 
                          Foreground="#6BCB77" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding NetworkUsage}" Maximum="100" Height="8" 
                                     Foreground="#6BCB77" Background="{ThemeResource WidgetBorderColor}" 
                                     CornerRadius="4" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding NetworkText}" 
                                   FontSize="12" FontWeight="Medium" 
                                   Foreground="{ThemeResource WidgetTextPrimary}" 
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Canvas x:Name="NetworkGraph" Height="40" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Height="36" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Pin"
                        Command="{Binding PinCommand}"
                        Background="{Binding State.IsPinned, Converter={StaticResource BoolToBrushConverter}, ConverterParameter={ThemeResource WidgetAccentColor}}">
                    <FontIcon Glyph="&#xE77A;" FontSize="14" 
                              Foreground="{Binding State.IsPinned, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=White}" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource WidgetHeaderButtonStyle}"
                        ToolTipService.ToolTip="Duplicate"
                        Command="{Binding DuplicateCommand}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
                </Button>
            </Grid>

            <Thumb x:Name="ResizeThumb"
                   Width="20" Height="20"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,4"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Path Data="M0,12 L12,0 M4,12 L12,8 M8,12 L12,4"
                              Stroke="{ThemeResource WidgetTextSecondary}"
                              StrokeThickness="1.5"
                              Opacity="0.5"
                              Stretch="None" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>