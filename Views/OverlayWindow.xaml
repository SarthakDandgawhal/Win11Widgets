<Window
    x:Class="Win11Widgets.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    xmlns:views="using:Win11Widgets.Views"
    xmlns:widgetViews="using:Win11Widgets.Views.Widgets"
    mc:Ignorable="d"
    Title="Win11 Widgets Overlay"
    MinWidth="400"
    MinHeight="100"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    SystemBackdrop="{x:Null}">

    <Window.Resources>
        <ResourceDictionary>
            <views:WidgetTemplateSelector x:Key="WidgetTemplateSelector"
                StickyNoteTemplate="{StaticResource StickyNoteTemplate}"
                ClockTemplate="{StaticResource ClockTemplate}"
                WeatherTemplate="{StaticResource WeatherTemplate}"
                SystemMonitorTemplate="{StaticResource SystemMonitorTemplate}"
                TodoListTemplate="{StaticResource TodoListTemplate}"
                CalendarTemplate="{StaticResource CalendarTemplate}"
                CalculatorTemplate="{StaticResource CalculatorTemplate}"
                ColorPickerTemplate="{StaticResource ColorPickerTemplate}" />
            
            <DataTemplate x:Key="StickyNoteTemplate">
                <widgetViews:StickyNoteWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="ClockTemplate">
                <widgetViews:ClockWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="WeatherTemplate">
                <widgetViews:WeatherWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="SystemMonitorTemplate">
                <widgetViews:SystemMonitorWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="TodoListTemplate">
                <widgetViews:TodoListWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="CalendarTemplate">
                <widgetViews:CalendarWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="CalculatorTemplate">
                <widgetViews:CalculatorWidgetView DataContext="{Binding}" />
            </DataTemplate>
            <DataTemplate x:Key="ColorPickerTemplate">
                <widgetViews:ColorPickerWidgetView DataContext="{Binding}" />
            </DataTemplate>

            <Style x:Key="WidgetContainerStyle" TargetType="ContentControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border
                                x:Name="WidgetBorder"
                                Background="{ThemeResource WidgetBackgroundColor}"
                                BorderBrush="{ThemeResource WidgetBorderColor}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="0"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform x:Name="WidgetTransform" />
                                </Border.RenderTransform>
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="12" RadiusY="12" />
                                </Border.Clip>
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Widgets Canvas -->
        <Canvas x:Name="WidgetsCanvas" Background="Transparent">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Widgets.Values, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WidgetViewModelBase">
                        <ContentControl
                            Style="{StaticResource WidgetContainerStyle}"
                            Width="{x:Bind State.Width, Mode=OneWay}"
                            Height="{x:Bind State.Height, Mode=OneWay}"
                            Opacity="{x:Bind State.Opacity, Mode=OneWay}"
                            Canvas.Left="{x:Bind State.X, Mode=OneWay}"
                            Canvas.Top="{x:Bind State.Y, Mode=OneWay}"
                            Canvas.ZIndex="{x:Bind State.ZIndex, Mode=OneWay}"
                            Content="{Binding}"
                            ContentTemplateSelector="{StaticResource WidgetTemplateSelector}">
                            <ContentControl.RenderTransform>
                                <TranslateTransform X="{x:Bind State.X, Mode=OneWay}" Y="{x:Bind State.Y, Mode=OneWay}" />
                            </ContentControl.RenderTransform>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Canvas>

        <!-- Floating Action Button -->
        <Button
            x:Name="FabButton"
            Width="56"
            Height="56"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"
            CornerRadius="28"
            Background="{ThemeResource WidgetAccentColor}"
            Foreground="White"
            Click="FabButton_Click"
            ToolTipService.ToolTip="Add Widget (Win+Shift+N)">
            <Button.Content>
                <FontIcon Glyph="&#xE710;" FontSize="24" />
            </Button.Content>
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
        </Button>

        <!-- Quick Actions Bar (when widgets exist) -->
        <StackPanel
            x:Name="QuickActionsBar"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,100"
            Spacing="12"
            Visibility="Collapsed">
            <Button
                Style="{StaticResource WidgetPrimaryButtonStyle}"
                Click="NewStickyNote_Click"
                ToolTipService.ToolTip="New Sticky Note">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="Sticky Note" FontSize="12" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource WidgetButtonStyle}"
                Click="NewClock_Click"
                ToolTipService.ToolTip="New Clock">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE917;" FontSize="14" />
                    <TextBlock Text="Clock" FontSize="12" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource WidgetButtonStyle}"
                Click="NewTodo_Click"
                ToolTipService.ToolTip="New Todo List">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                    <TextBlock Text="Todo List" FontSize="12" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource WidgetButtonStyle}"
                Click="OpenGallery_Click"
                ToolTipService.ToolTip="Widget Gallery">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE781;" FontSize="14" />
                    <TextBlock Text="Gallery" FontSize="12" />
                </StackPanel>
            </Button>
            <Button
                Style="{StaticResource WidgetButtonStyle}"
                Click="OpenSettings_Click"
                ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </StackPanel>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE781;" FontSize="64" Foreground="{ThemeResource WidgetTextSecondary}" Opacity="0.5" />
            <TextBlock
                Text="No widgets yet"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{ThemeResource WidgetTextPrimary}"
                TextAlignment="Center" />
            <TextBlock
                Text="Click the + button or press Win+Shift+N to add your first widget"
                FontSize="14"
                Foreground="{ThemeResource WidgetTextSecondary}"
                TextAlignment="Center"
                MaxWidth="300" />
            <Button
                Style="{StaticResource WidgetPrimaryButtonStyle}"
                HorizontalAlignment="Center"
                Click="FabButton_Click"
                Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="Add Widget" FontSize="14" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>