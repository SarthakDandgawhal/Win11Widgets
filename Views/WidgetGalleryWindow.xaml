<Window
    x:Class="Win11Widgets.Views.WidgetGalleryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    Title="Widget Gallery"
    Width="700"
    Height="600"
    MinWidth="600"
    MinHeight="500"
    ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Widget Gallery" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource WidgetTextPrimary}" />
            <TextBlock Text="Browse and add widgets to your desktop" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
        </StackPanel>

        <!-- Search & Filter -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox Grid.Column="0"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search widgets..."
                            QueryIcon="Find"
                            Width="300"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,0" />

            <ComboBox Grid.Column="1"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      ItemsSource="{Binding Categories}"
                      Width="160"
                      HorizontalAlignment="Right" />
        </Grid>

        <!-- Widget Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredWidgets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" ItemWidth="300" ItemHeight="320" HorizontalChildrenAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WidgetDefinition">
                        <Border Width="280" Height="280" Margin="8"
                                Background="{ThemeResource WidgetBackgroundColor}"
                                BorderBrush="{ThemeResource WidgetBorderColor}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <!-- Icon -->
                                <FontIcon Glyph="{Binding IconGlyph}"
                                          FontSize="48"
                                          Foreground="{ThemeResource WidgetAccentColor}"
                                          HorizontalAlignment="Center" />

                                <!-- Name & Category -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource WidgetTextPrimary}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                    <TextBlock Text="{Binding Category}"
                                               FontSize="12"
                                               Foreground="{ThemeResource WidgetTextSecondary}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.7" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Text="{Binding Description}"
                                           FontSize="13"
                                           Foreground="{ThemeResource WidgetTextSecondary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxLines="3" />

                                <!-- Add Button -->
                                <Button Style="{StaticResource WidgetPrimaryButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Padding="20,8"
                                        Command="{Binding DataContext.AddWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock Text="Add Widget" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Style="{StaticResource WidgetButtonStyle}"
                    Click="Close_Click"
                    Padding="16,8">
                <TextBlock Text="Close" FontSize="13" />
            </Button>
        </StackPanel>
    </Grid>
</Window>