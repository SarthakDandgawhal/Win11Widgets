<Window
    x:Class="Win11Widgets.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Win11Widgets.ViewModels"
    mc:Ignorable="d"
    Title="Settings"
    Width="500"
    Height="600"
    MinWidth="450"
    MinHeight="500"
    ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource WidgetTextPrimary}" />
            <TextBlock Text="Configure Win11 Widgets Manager" FontSize="14" Foreground="{ThemeResource WidgetTextSecondary}" />
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                <!-- General -->
                <Border Background="{ThemeResource WidgetBackgroundColor}" BorderBrush="{ThemeResource WidgetBorderColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="General" Style="{StaticResource WidgetTitleStyle}" FontSize="16" />
                        
                        <StackPanel Spacing="12">
                            <ToggleSwitch Header="Auto-start with Windows" 
                                          OnContent="Enabled" OffContent="Disabled"
                                          IsOn="{Binding Settings.AutoStart, Mode=TwoWay}" />
                            <ToggleSwitch Header="Show in System Tray" 
                                          OnContent="Enabled" OffContent="Disabled"
                                          IsOn="{Binding Settings.ShowInSystemTray, Mode=TwoWay}" />
                            <ToggleSwitch Header="Enable Drop Shadows" 
                                          OnContent="Enabled" OffContent="Disabled"
                                          IsOn="{Binding Settings.EnableDropShadow, Mode=TwoWay}" />
                            <ToggleSwitch Header="Snap to Grid" 
                                          OnContent="Enabled" OffContent="Disabled"
                                          IsOn="{Binding Settings.SnapToGrid, Mode=TwoWay}" />
                            <ToggleSwitch Header="Show Widget Borders" 
                                          OnContent="Enabled" OffContent="Disabled"
                                          IsOn="{Binding Settings.ShowWidgetBorders, Mode=TwoWay}" />
                            <ToggleSwitch Header="Enable Hotkeys" 
                                          OnContent="Enabled" OffContent="Disabled"
                                          IsOn="{Binding Settings.EnableHotkeys, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Background="{ThemeResource WidgetBackgroundColor}" BorderBrush="{ThemeResource WidgetBorderColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Appearance" Style="{StaticResource WidgetTitleStyle}" FontSize="16" />
                        
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Theme" Style="{StaticResource WidgetBodyStyle}" />
                                <ComboBox SelectedItem="{Binding Settings.Theme, Mode=TwoWay}"
                                          ItemsSource="{Binding Themes}"
                                          HorizontalAlignment="Left"
                                          Width="200" />
                            </StackPanel>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Default Widget Opacity" Style="{StaticResource WidgetBodyStyle}" />
                                <Slider Minimum="0.5" Maximum="1.0" StepFrequency="0.05"
                                        Value="{Binding Settings.DefaultWidgetOpacity, Mode=TwoWay}"
                                        Width="200" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Grid Size (pixels)" Style="{StaticResource WidgetBodyStyle}" />
                                <NumberBox Minimum="10" Maximum="50" Step="5"
                                           Value="{Binding Settings.GridSize, Mode=TwoWay}"
                                           Width="100" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Widget Spacing" Style="{StaticResource WidgetBodyStyle}" />
                                <NumberBox Minimum="0" Maximum="30" Step="2"
                                           Value="{Binding Settings.WidgetSpacing, Mode=TwoWay}"
                                           Width="100" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Animation Duration (ms)" Style="{StaticResource WidgetBodyStyle}" />
                                <NumberBox Minimum="0" Maximum="500" Step="50"
                                           Value="{Binding Settings.AnimationDurationMs, Mode=TwoWay}"
                                           Width="100" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Background="{ThemeResource WidgetBackgroundColor}" BorderBrush="{ThemeResource WidgetBorderColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Hotkeys" Style="{StaticResource WidgetTitleStyle}" FontSize="16" />
                        
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Toggle Overlay" Style="{StaticResource WidgetBodyStyle}" />
                                <TextBox Text="{Binding Settings.HotkeyToggleOverlay, Mode=TwoWay}"
                                         Width="200" HorizontalAlignment="Left"
                                         IsReadOnly="True"
                                         PlaceholderText="Win+Shift+W" />
                            </StackPanel>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="New Widget" Style="{StaticResource WidgetBodyStyle}" />
                                <TextBox Text="{Binding Settings.HotkeyNewWidget, Mode=TwoWay}"
                                         Width="200" HorizontalAlignment="Left"
                                         IsReadOnly="True"
                                         PlaceholderText="Win+Shift+N" />
                            </StackPanel>
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Open Settings" Style="{StaticResource WidgetBodyStyle}" />
                                <TextBox Text="{Binding Settings.HotkeySettings, Mode=TwoWay}"
                                         Width="200" HorizontalAlignment="Left"
                                         IsReadOnly="True"
                                         PlaceholderText="Win+Shift+S" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Default Widget Size -->
                <Border Background="{ThemeResource WidgetBackgroundColor}" BorderBrush="{ThemeResource WidgetBorderColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Default Widget Size" Style="{StaticResource WidgetTitleStyle}" FontSize="16" />
                        
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Width" Style="{StaticResource WidgetBodyStyle}" />
                                <NumberBox Minimum="150" Maximum="800" Step="10"
                                           Value="{Binding Settings.DefaultWidgetWidth, Mode=TwoWay}"
                                           Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Height" Style="{StaticResource WidgetBodyStyle}" />
                                <NumberBox Minimum="100" Maximum="800" Step="10"
                                           Value="{Binding Settings.DefaultWidgetHeight, Mode=TwoWay}"
                                           Width="150" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Background="{ThemeResource WidgetBackgroundColor}" BorderBrush="{ThemeResource WidgetBorderColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Data" Style="{StaticResource WidgetTitleStyle}" FontSize="16" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Style="{StaticResource WidgetButtonStyle}"
                                    Command="{Binding ResetToDefaultsCommand}"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74C;" FontSize="14" />
                                    <TextBlock Text="Reset to Defaults" FontSize="13" />
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource WidgetPrimaryButtonStyle}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Save Settings" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Style="{StaticResource WidgetButtonStyle}"
                    Click="Close_Click"
                    Padding="16,8">
                <TextBlock Text="Close" FontSize="13" />
            </Button>
        </StackPanel>
    </Grid>
</Window>