<Application
    x:Class="Win11Widgets.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Win11Widgets"
    xmlns:converters="using:Win11Widgets.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
            <converters:StringToColorConverter x:Key="StringToColorConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:BoolToTextDecorationsConverter x:Key="BoolToTextDecorationsConverter" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
            
            <!-- Theme Colors -->
            <Color x:Key="WidgetBackgroundColor">#FF1E1E1E</Color>
            <Color x:Key="WidgetBorderColor">#FF333333</Color>
            <Color x:Key="WidgetAccentColor">#FF0078D4</Color>
            <Color x:Key("WidgetTextPrimary")>#FFFFFFFF</Color>
            <Color x:Key="WidgetTextSecondary">#FFCCCCCC</Color>
            <Color x:Key("WidgetHoverColor")>#FF2D2D2D</Color>
            <Color x:Key("WidgetDragOverlayColor")>#330078D4</Color>
            <Color x:Key("SystemTrayIconColor")>#FF0078D4</Color>
            
            <!-- Styles -->
            <Style x:Key="WidgetTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetTextPrimary}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            
            <Style x:Key="WidgetBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetTextSecondary}" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
            
            <Style x:Key="WidgetButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource WidgetBorderColor}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetTextPrimary}" />
            </Style>
            
            <Style x:Key="WidgetPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource WidgetButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource WidgetAccentColor}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WidgetAccentColor}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            
            <Style x:Key="WidgetIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>
            
            <ControlTemplate x:Key="WidgetWindowTemplate" TargetType="Window">
                <Grid Background="{ThemeResource WidgetBackgroundColor}">
                    <Border 
                        BorderBrush="{ThemeResource WidgetBorderColor}" 
                        BorderThickness="1"
                        Background="{ThemeResource WidgetBackgroundColor}"
                        CornerRadius="12">
                        <ContentPresenter />
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- Calculator Button Styles -->
            <Style x:Key="CalcButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource WidgetHoverColor}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WidgetBorderColor}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetTextPrimary}" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CalcOperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
                <Setter Property="Background" Value="#FF0078D4" />
                <Setter Property="BorderBrush" Value="#FF0078D4" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="CalcEqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
                <Setter Property="Background" Value="#FF107C10" />
                <Setter Property="BorderBrush" Value="#FF107C10" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Day Header Style -->
            <Style x:Key="DayHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetTextSecondary}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Opacity" Value="0.7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>